{
  "description": "Notify when a usage/rate limit stops a turn (Claude Auto companion)",
  "hooks": {
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/on-rate-limit.mjs\""
          }
        ]
      }
    ]
  }
}
